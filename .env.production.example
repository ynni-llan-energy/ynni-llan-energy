# ============================================================
# Ynni Cymunedol Llanfairfechan — Production environment (Hetzner box)
# Copy this to /opt/ynni-llan-energy/.env and fill in real values.
# Read only by docker-compose.yml and the systemd units in deploy/ —
# never by CI (see .github/workflows/deploy.yml's comments on why).
# ============================================================

# Postgres — the db service creates its data dir with these on first boot.
# Changing POSTGRES_PASSWORD after that requires an in-database ALTER ROLE,
# not just editing this file.
POSTGRES_USER=ynni_llan
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=ynni_llan

# Same credentials, as a connection string — web and migrate both read this.
DATABASE_URL=postgres://ynni_llan:change-me-generate-a-real-password@db:5432/ynni_llan

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=your-real-auth-secret
AUTH_URL=https://your-real-domain
SITE_URL=https://your-real-domain

# Caddy reads this directly (docker-compose.yml passes it through) for
# automatic HTTPS — must match AUTH_URL/SITE_URL's host.
SITE_DOMAIN=your-real-domain

# Resend — resend.com > API Keys
RESEND_API_KEY=re_your-real-resend-api-key
RESEND_FROM_ADDRESS=Ynni Cymunedol Llanfairfechan <aelodaeth@ynni-llan.cymru>

# Cron secret — the systemd timers in deploy/systemd/ send this as a
# Bearer token to /api/cron/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-real-cron-secret

# Sanity — sanity.io/manage. NEXT_PUBLIC_* values here only matter for a
# manual `docker compose build` on the box; the images CI pushes already
# have them baked in from GitHub Actions secrets.
SANITY_API_TOKEN=your-real-sanity-api-token
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_PREVIEW_SECRET=your-preview-secret

# Image tags — deploy.yml overrides these per-deploy with the freshly built
# SHA-tagged images; set to :latest here just so a manual
# `docker compose up -d` works before the first CI deploy has run.
WEB_IMAGE=ghcr.io/ynni-llan-energy/ynni-llan-energy-web:latest
MIGRATE_IMAGE=ghcr.io/ynni-llan-energy/ynni-llan-energy-migrate:latest
