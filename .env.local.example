# ============================================================
# Ynni Cymunedol Llanfairfechan — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.
# ============================================================

# Site URL — used for magic link redirects (server-side only, no NEXT_PUBLIC_ prefix).
# In Vercel: set SITE_URL=https://yourdomain.com for Production environment only.
# Preview deployments will use VERCEL_URL automatically.
SITE_URL=http://localhost:3000

# Postgres — local dev: docker compose -f docker-compose.dev.yml up -d
# then use the credentials from that file.
DATABASE_URL=postgres://ynni_llan:dev_password_only@localhost:5432/ynni_llan_dev

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=your-auth-secret
# Auth.js reads AUTH_URL for callback/redirect construction; keep it in sync
# with SITE_URL above (same canonical URL, different variable name).
AUTH_URL=http://localhost:3000

# Sanity — get these from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEXT_PUBLIC_ prefix is required — sanity.config.ts runs in the browser
NEXT_PUBLIC_SANITY_PREVIEW_SECRET=your-preview-secret

# Resend — get this from resend.com > API Keys
RESEND_API_KEY=re_your-resend-api-key

# Cron job secret — used to authenticate the /api/cron/membership and
# /api/cron/admin-digest endpoints, which a host scheduler (systemd timer /
# OS cron) curls with this as a Bearer token — see Milestone 2 for the
# scheduling setup, once the Hetzner box is in the picture.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret
